//     Loans[interest_rate] < 16, "12-16%", Loans[interest_rate] < 20, "16-20%", "20%+" )
// DTI Band = SWITCH ( TRUE (), ISBLANK ( Loans[dti] ), "Unknown", Loans[dti] < 10, "<10", Loans[dti] < 20, "10-20", Loans[dti] < 30, "20-30", "30+" )
// Income Band = SWITCH ( TRUE (), ISBLANK ( Loans[annual_income] ), "Unknown", Loans[annual_income] < 30000, "<30k",
//     Loans[annual_income] < 60000, "30-60k", Loans[annual_income] < 90000, "60-90k", "90k+" )
// Issue Year = YEAR ( Loans[issue_date] )
// Data Kind Label = IF ( Loans[source_kind] = "synthetic", "SYNTHETIC - demo only", "Observed" )
